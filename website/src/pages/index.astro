---
import BaseLayout from "../layouts/BaseLayout.astro";
import CatalogCard from "../components/CatalogCard.astro";
import { getCatalog } from "../lib/catalog";
import { SITE } from "../lib/site";
import { sitePath } from "../lib/paths";
const works = getCatalog();
const hardware = works.filter(
  (w) => (w.hardwareImage ?? w.coverImage ?? w.image) && (w.kind === "System" || w.form !== "Not reported"),
);
const initial = [
  "2402.10329",
  "2505.21864",
  "2607.25895",
  "2606.10244",
  "2609.29760",
  "2511.05858",
  "2604.14089",
  "2409.19499",
  "2601.09988",
  "2407.10353",
  "2604.13001",
  "2512.09851",
];
const first = hardware.slice(0, 12);
const years = [...new Set(works.map((w) => w.year))].sort().reverse();
const access = [...new Set(works.map((w) => w.dataAccess))].sort();
const icon = {
  search: "M21 21l-4.35-4.35M19 11a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z",
  filter: "M4 7h16M7 12h10M10 17h4",
  chevron: "m6 9 6 6 6-6",
  close: "m6 6 12 12M6 18 18 6",
  share: "M12 16V3m-4 4 4-4 4 4M5 12v8h14v-8",
};
---

<BaseLayout
  title="Awesome UMI — Interfaces for robot learning"
  description={SITE.description}
>
  <section class="library-intro wrap">
    <h1><span>Human skill.</span>{" "}<span>Robot potential.</span></h1>
    <p>
      A living collection of interfaces, datasets, and ideas for robot learning.
    </p>
  </section>
  <section class="library wrap" id="library" aria-label="Research library">
    <div class="library-toolbar" id="library-toolbar">
      <div class="library-tabs" role="group" aria-label="Collection">
        <button type="button" data-collection="hardware" aria-pressed="true">
          Hardware
        </button>
        <button type="button" data-collection="datasets" aria-pressed="false">
          Datasets
        </button>
        <button type="button" data-collection="research" aria-pressed="false">
          All research
        </button>
      </div>
      <label class="search-field">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d={icon.search} />
        </svg>
        <input
          id="catalog-search"
          type="search"
          autocomplete="off"
          placeholder="Find a device, sensor, dataset, or institution…"
          aria-label="Search the library"
        />
        <kbd>/</kbd>
      </label>
      <button
        class="filters-toggle"
        id="filters-toggle"
        aria-label="Filters"
        aria-expanded="false"
        aria-controls="filter-panel"
        type="button"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d={icon.filter} />
        </svg>
        <span>Filters</span>
        <span class="filter-count" id="filter-count" hidden>
          0
        </span>
      </button>
      <div class="filter-panel" id="filter-panel" hidden>
        <div class="filter-heading">
          <h2>Refine your collection</h2>
          <button id="reset-filters" type="button">
            Reset
          </button>
        </div>
        <div class="filter-fields">
          <label>
            Research area
            <select id="source-filter">
              <option value="all">All areas</option>
              {["Core", "Method", "Dataset", "Policy", "Taxonomy"].map((v) => (
                <option value={v}>{v}</option>
              ))}
            </select>
          </label>
          <label>
            Interface
            <select id="form-filter">
              <option value="all">All interfaces</option>
              {[
                "Handheld",
                "Wearable",
                "Mobile",
                "Whole-body",
                "Not reported",
              ].map((v) => (
                <option value={v}>{v}</option>
              ))}
            </select>
          </label>
          <label>
            Tactile sensing
            <select id="tactile-filter">
              <option value="all">Any status</option>
              <option value="present">Present</option>
              <option value="optional">Optional</option>
              <option value="none">None</option>
              <option value="unknown">Not verified</option>
            </select>
          </label>
          <label>
            Force / torque
            <select id="force-filter">
              <option value="all">Any status</option>
              <option value="present">Present</option>
              <option value="optional">Optional</option>
              <option value="none">None</option>
              <option value="unknown">Not verified</option>
            </select>
          </label>
          <label>
            Dataset access
            <select id="access-filter">
              <option value="all">All access states</option>
              {access.map((v) => (
                <option value={v}>{v}</option>
              ))}
            </select>
          </label>
          <label>
            Source release
            <select id="openness-filter">
              <option value="all">All releases</option>
              <option value="open">Open source</option>
              <option value="partial">Partial release</option>
              <option value="closed">Closed source</option>
              <option value="unknown">Unknown</option>
            </select>
          </label>
          <label>
            Availability
            <select id="availability-filter">
              <option value="all">Research & products</option>
              <option value="research">Research / DIY</option>
              <option value="commercial">Companies & products</option>
            </select>
          </label>
          <label>
            Paper / resource year
            <select id="year-filter">
              <option value="all">All years</option>
              {years.map((v) => (
                <option value={v}>{v}</option>
              ))}
            </select>
          </label>
        </div>
        <fieldset class="signal-filters">
          <legend>Recorded channels</legend>
          {[
            "Vision",
            "Tactile",
            "Force",
            "Audio",
            "Depth",
            "IMU",
            "Contact",
            "Proprioception",
          ].map((v) => (
            <label>
              <input type="checkbox" name="signal" value={v} />
              <span>
                {v === "Proprioception" ? "State / proprioception" : v}
              </span>
            </label>
          ))}
        </fieldset>
        <p class="filter-note">
          Open source requires licensed hardware files and software. Partial
          releases and unknown status are separate; commercial products may include open software.
        </p>
        <button type="button" id="apply-filters" class="button-dark">
          Done
        </button>
      </div>
    </div>
    <div class="library-meta">
      <p id="result-count" role="status" aria-live="polite">
        {hardware.length} hardware entries
      </p>
      <div class="library-meta-actions">
        <button type="button" id="share-view" aria-label="Copy this view link">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={icon.share} />
          </svg>
          <span>Share view</span>
        </button>
        <label class="sort-label">
          <span>Sort:</span>
          <select id="sort-order" aria-label="Sort results">
            <option value="newest" selected>Newest</option>
            <option value="oldest">Oldest</option>
            <option value="name">Name A–Z</option>
            <option value="recommended">Curated</option>
          </select>
        </label>
      </div>
    </div>
    <div
      class="active-filters"
      id="active-filters"
      aria-label="Active filters"
    ></div>
    <div id="catalog-results" class="catalog-feed" aria-busy="false">
      <div class="feed-batch">
        {first.map((w) => w && <CatalogCard work={w} />)}
      </div>
    </div>
    <div id="catalog-empty" class="empty-state" hidden>
      <h2>No matches this time.</h2>
      <p>Try another phrase or use fewer filters.</p>
      <button type="button" id="empty-reset" class="button-dark">
        Clear filters
      </button>
    </div>
    <div class="feed-boundary" id="feed-boundary">
      <div
        class="loading-dots"
        id="loading-dots"
        role="status"
        aria-label="Loading more entries"
        hidden
      >
        <i></i>
        <i></i>
        <i></i>
      </div>
      <span id="feed-end" hidden>
        end
      </span>
      <div id="feed-error" hidden>
        <p>The collection could not be loaded.</p>
        <button type="button" id="retry-load">
          Try again
        </button>
      </div>
    </div>
    <noscript>
      <p class="no-script">
        For the complete collection,{" "}
        <a href={SITE.github + "#readme"}>read the README</a>. Search,
        comparison, and continuous loading require JavaScript.
      </p>
    </noscript>
  </section>
  <div class="compare-tray" id="compare-tray" hidden>
    <div>
      <strong id="compare-count">0 selected</strong>
      <span id="compare-names"></span>
    </div>
    <button type="button" id="open-compare" class="button-dark" disabled>
      Compare
    </button>
    <button
      type="button"
      id="clear-compare"
      class="icon-button"
      aria-label="Clear comparison"
    >
      <svg viewBox="0 0 24 24">
        <path d={icon.close} />
      </svg>
    </button>
  </div>
  <dialog id="detail-dialog" class="detail-dialog">
    <button
      type="button"
      class="dialog-close icon-button"
      data-close
      aria-label="Close details"
    >
      <svg viewBox="0 0 24 24">
        <path d={icon.close} />
      </svg>
    </button>
    <div id="detail-content"></div>
  </dialog>
  <dialog id="compare-dialog" class="compare-dialog">
    <button
      type="button"
      class="dialog-close icon-button"
      data-close
      aria-label="Close comparison"
    >
      <svg viewBox="0 0 24 24">
        <path d={icon.close} />
      </svg>
    </button>
    <div id="compare-content"></div>
  </dialog>
  <dialog id="about-dialog" class="about-dialog">
    <button
      type="button"
      class="dialog-close icon-button"
      data-close
      aria-label="Close about"
    >
      <svg viewBox="0 0 24 24">
        <path d={icon.close} />
      </svg>
    </button>
    <h2>A clearer view of UMI.</h2>
    <p>
      Awesome UMI connects the hardware, datasets, and research behind robot
      learning from human demonstrations.
    </p>
    <p>
      The README is the canonical collection. Specifications and release
      information are checked against papers and official resources. Images
      belong to their credited projects.
    </p>
    <p>
      Paper-reported scale, indexed data, and downloadable releases are kept
      separate. Missing information stays unverified.
    </p>
    <a class="button-dark" href={SITE.github + "#readme"}>
      Read the collection ↗
    </a>
  </dialog>
  <p id="announcement" class="toast" role="status" aria-live="polite"></p>
  <script
    is:inline
    id="catalog-settings"
    type="application/json"
    set:html={JSON.stringify({
      initial,
      base: import.meta.env.BASE_URL,
      endpoint: sitePath("catalog.json"),
      github: SITE.github,
    })}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: SITE.name,
      description: SITE.description,
      numberOfItems: works.length,
    })}
  />
  <script>
    import "../scripts/atlas";
  </script>
</BaseLayout>
