---
import BaseLayout from "../layouts/BaseLayout.astro";
import CatalogCard from "../components/CatalogCard.astro";
import { getCatalog } from "../lib/catalog";
import { SITE } from "../lib/site";
import { sitePath } from "../lib/paths";
const works = getCatalog();
const visual = works.filter((w) => w.image);
const sources = [...new Set(works.map((w) => w.source))];
const years = [...new Set(works.map((w) => w.year))].sort().reverse();
const hero =
  SITE.kind === "umi"
    ? ["2607.25895", "2402.10329", "2505.21864"]
    : ["2403.12945", "2607.25895", "2311.18259", "2603.04356"];
const heroWorks = hero
  .map((id) => works.find((w) => w.id === id && w.image))
  .filter(Boolean);
const initial =
  SITE.kind === "umi"
    ? [
        "2402.10329",
        "2505.21864",
        "2606.10244",
        "2609.29760",
        "2511.05858",
        "2604.14089",
      ]
    : [
        "2403.12945",
        "2310.08864",
        "2412.13877",
        "2402.10329",
        "2311.18259",
        "2603.04356",
      ];
const data = JSON.stringify(works).replace(/</g, "\\u003c");
---

<BaseLayout
  title={SITE.name + " — " + SITE.tagline}
  description={SITE.description}
>
  <section
    class:list={[
      "atlas-hero",
      "shell",
      SITE.kind === "umi" ? "is-umi" : "is-engine",
    ]}
  >
    <div class="atlas-intro">
      <p class="atlas-eyebrow">
        <span class="live-dot"></span>
        {SITE.kind === "umi"
          ? "THE HARDWARE & LEARNING FIELD GUIDE"
          : "THE ROBOT DATA FIELD GUIDE"}
      </p>
      <h1>
        {SITE.kind === "umi" ? (
          <>
            Human demonstrations.
            <br />
            <em>Robot possibilities.</em>
          </>
        ) : (
          <>
            Experience in.
            <br />
            <em>Robot-ready data out.</em>
          </>
        )}
      </h1>
      <p class="atlas-deck">{SITE.description}</p>
      <div class="atlas-hero-actions">
        <a class="atlas-primary" href="#catalog">
          {SITE.kind === "umi"
            ? "Explore the interfaces"
            : "Explore the data ecosystem"}{" "}
          <span aria-hidden="true">↗</span>
        </a>
        <a href={SITE.github + "#readme"} class="atlas-text-link">
          Read the awesome list <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="atlas-facts">
        <span>
          <strong>{works.length}</strong> unique works
        </span>
        <span>
          <strong>{visual.length}</strong> visual entries
        </span>
        <span>Primary-source curation</span>
      </div>
    </div>
    <div
      class:list={[
        "atlas-hero-visual",
        SITE.kind === "umi" ? "hardware-board" : "source-board",
      ]}
    >
      {heroWorks.map(
        (w, i) =>
          w && (
            <a
              class:list={["hero-specimen", i === 0 && "specimen-main"]}
              href={"?item=" + w.id + "#catalog"}
              aria-label={"View " + w.name}
            >
              <img
                src={sitePath(w.image!)}
                alt={w.imageAlt}
                width="640"
                height="380"
                loading={i === 0 ? "eager" : "lazy"}
              />
              <div>
                <span>
                  {SITE.kind === "umi"
                    ? w.form === "Not reported"
                      ? "ROBOT-FREE INTERFACE"
                      : w.form + " INTERFACE"
                    : w.source}
                </span>
                <strong>
                  {w.name}
                  <b aria-hidden="true">↗</b>
                </strong>
              </div>
            </a>
          ),
      )}
      <span class="board-caption">
        {SITE.kind === "umi"
          ? "Different interfaces. A shared path from human to robot."
          : "Four sources of experience. One connected data engine."}
      </span>
    </div>
  </section>
  {SITE.kind === "engine" && (
    <nav
      class="atlas-pipeline shell"
      aria-label="Browse the data engine by stage"
    >
      <span>FOLLOW THE DATA</span>
      {[
        "Collect",
        "Recover",
        "Align",
        "Curate",
        "Generate",
        "Mix",
        "Evaluate",
      ].map((s) => (
        <a href={"?stage=" + s + "&view=index#catalog"}>
          {s}
          <span aria-hidden="true">→</span>
        </a>
      ))}
    </nav>
  )}
  <section
    id="catalog"
    class="atlas-catalog shell"
    aria-labelledby="catalog-title"
  >
    <div class="atlas-catalog-heading">
      <div>
        <p class="atlas-eyebrow">
          {SITE.kind === "umi"
            ? "A CLOSER LOOK AT THE ECOSYSTEM"
            : "FIND THE NEXT PIECE OF YOUR PIPELINE"}
        </p>
        <h2 id="catalog-title">
          {SITE.kind === "umi"
            ? "Meet the interfaces."
            : "Explore the ecosystem."}
        </h2>
      </div>
      <p>
        Browse visually. Investigate deeply.
        <br />
        Compare the details that matter.
      </p>
    </div>
    <div class="atlas-browser">
      <aside class="atlas-filters" aria-label="Catalog filters">
        <details id="filter-panel" open>
          <summary>
            Refine your view <span aria-hidden="true">⌄</span>
          </summary>
          <div class="filter-body">
            <label class="atlas-select-label">
              {SITE.kind === "umi" ? "Research area" : "Data source"}
              <select id="source-filter">
                <option value="all">
                  All {SITE.kind === "umi" ? "areas" : "sources"}
                </option>
                {sources.map((s) => (
                  <option value={s}>{s}</option>
                ))}
              </select>
            </label>
            <fieldset>
              <legend>
                {SITE.kind === "umi" ? "Interface form" : "Pipeline stage"}
              </legend>
              {(SITE.kind === "umi"
                ? ["Handheld", "Wearable", "Mobile", "Whole-body"]
                : [
                    "Collect",
                    "Recover",
                    "Align",
                    "Curate",
                    "Generate",
                    "Mix",
                    "Evaluate",
                    "Dataset",
                  ]
              ).map((v) => (
                <label class="atlas-check">
                  <input type="checkbox" name="facet" value={v} />
                  <span>{v}</span>
                </label>
              ))}
            </fieldset>
            <fieldset>
              <legend>Observation signals</legend>
              {[
                "Vision",
                "Tactile",
                "Force",
                "Audio",
                "Depth",
                "IMU",
                "Contact",
                "Proprioception",
              ].map((v) => (
                <label class="atlas-check">
                  <input type="checkbox" name="signal" value={v} />
                  <span>{v}</span>
                </label>
              ))}
            </fieldset>
            <label class="atlas-select-label">
              First release
              <select id="year-filter">
                <option value="all">All years</option>
                {years.map((y) => (
                  <option value={y}>{y}</option>
                ))}
              </select>
            </label>
            <label class="atlas-select-label">
              Dataset access
              <select id="access-filter">
                <option value="all">All access states</option>
                {[
                  "Dataset linked",
                  "Public subset",
                  "Access conditions",
                  "Release pending",
                  "Not reported",
                ].map((v) => (
                  <option value={v}>{v}</option>
                ))}
              </select>
            </label>
            <button id="reset-filters" class="atlas-reset" type="button">
              Reset all filters <span aria-hidden="true">↺</span>
            </button>
            <p class="atlas-filter-note">
              Unreported attributes stay unreported. A linked repository or
              dataset is not a claim of a complete release.
            </p>
          </div>
        </details>
      </aside>
      <div class="atlas-results-area">
        <div class="atlas-toolbar">
          <div class="atlas-view-tabs" role="group" aria-label="Catalog view">
            <button data-view="gallery" aria-pressed="true">
              Visual atlas <span>{visual.length}</span>
            </button>
            <button data-view="index" aria-pressed="false">
              Research index <span>{works.length}</span>
            </button>
          </div>
          <button class="atlas-share" id="share-view" type="button">
            Share view ↗
          </button>
        </div>
        <div class="atlas-search-row">
          <label class="atlas-search">
            <span aria-hidden="true">⌕</span>
            <input
              id="catalog-search"
              type="search"
              placeholder={
                SITE.kind === "umi"
                  ? "Find a device, sensor, policy, or institution…"
                  : "Find a dataset, method, benchmark, or institution…"
              }
              aria-label="Search the catalog"
              autocomplete="off"
            />
            <kbd>/</kbd>
          </label>
          <select id="sort-order" aria-label="Sort results">
            <option value="recommended">Curated order</option>
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
            <option value="name">Name A–Z</option>
          </select>
        </div>
        <div
          id="active-filters"
          class="atlas-active-filters"
          aria-label="Active filters"
        ></div>
        <div class="atlas-results-meta">
          <p id="result-count" role="status" aria-live="polite">
            {visual.length} visual entries
          </p>
          <span id="view-explanation">
            Selected projects with official imagery · full coverage in Research
            index
          </span>
        </div>
        <div id="catalog-results" class="atlas-grid">
          {visual.slice(0, 24).map((work) => (
            <CatalogCard work={work} />
          ))}
        </div>
        <div class="atlas-empty" id="catalog-empty" hidden>
          <span aria-hidden="true">⌕</span>
          <h3>No matching entries</h3>
          <p>Try fewer filters, or search the complete research index.</p>
          <button id="empty-index" type="button" class="atlas-primary">
            Search the research index
          </button>
          <button id="empty-reset" type="button" class="atlas-reset">
            Clear filters
          </button>
        </div>
        <div class="atlas-more-wrap">
          <button id="load-more" class="atlas-more" type="button">
            Show more entries <span aria-hidden="true">↓</span>
          </button>
        </div>
        <noscript>
          <p>
            The interactive explorer needs JavaScript.{" "}
            <a href={SITE.github + "#readme"}>
              Read every entry in the accessible README
            </a>
            .
          </p>
        </noscript>
      </div>
    </div>
  </section>
  <section class="atlas-about shell">
    <div>
      <p class="atlas-eyebrow">BUILT FOR RESEARCH THAT MOVES</p>
      <h2>
        A useful starting point.
        <br />A traceable path forward.
      </h2>
    </div>
    <div>
      <p>
        Every work connects back to its paper and official resources. Images are
        credited to their original projects. This field guide helps you discover
        and compare; primary sources hold the full technical detail.
      </p>
      <a class="atlas-text-link" href={SITE.github + "/issues/new"}>
        Suggest a resource or correction ↗
      </a>
    </div>
  </section>
  <div class="atlas-tray" id="compare-tray" hidden>
    <div>
      <strong id="compare-count">0 selected</strong>
      <span id="compare-names"></span>
    </div>
    <button id="open-compare" class="atlas-primary" type="button" disabled>
      Compare selected
    </button>
    <button id="clear-compare" type="button" aria-label="Clear comparison">
      ×
    </button>
  </div>
  <dialog id="detail-dialog" class="atlas-dialog">
    <button
      class="atlas-dialog-close"
      data-close
      type="button"
      aria-label="Close details"
    >
      ×
    </button>
    <div id="detail-content"></div>
  </dialog>
  <dialog id="compare-dialog" class="atlas-dialog atlas-compare-dialog">
    <button
      class="atlas-dialog-close"
      data-close
      type="button"
      aria-label="Close comparison"
    >
      ×
    </button>
    <div id="compare-content"></div>
  </dialog>
  <p
    id="atlas-announcement"
    class="atlas-toast"
    role="status"
    aria-live="polite"
  ></p>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: SITE.name,
      description: SITE.description,
      mainEntity: {
        "@type": "ItemList",
        itemListElement: visual
          .slice(0, 24)
          .map((w, i) => ({
            "@type": "ListItem",
            position: i + 1,
            name: w.name,
            url: w.paperUrl,
          })),
      },
    })}
  />
  <script is:inline id="catalog-data" type="application/json" set:html={data} />
  <script
    is:inline
    id="catalog-settings"
    type="application/json"
    set:html={JSON.stringify({
      kind: SITE.kind,
      initial,
      base: import.meta.env.BASE_URL,
    })}
  />
  <script>
    import "../scripts/atlas";
  </script>
</BaseLayout>
