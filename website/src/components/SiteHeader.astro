---
import { SITE } from "../lib/site";
import { sitePath } from "../lib/paths";
interface Props {
  pathname: string;
}
---

<header class="atlas-header">
  <div class="shell atlas-nav">
    <a class="atlas-brand" href={sitePath()}>
      <span class="atlas-brand-mark" aria-hidden="true">
        {SITE.kind === "umi" ? (
          <svg viewBox="0 0 32 32">
            <path d="M9 5v9l-4 7 5 6m13-22v9l4 7-5 6M9 10h14M12 22h8" />
          </svg>
        ) : (
          <svg viewBox="0 0 32 32">
            <path d="M5 8h8v8H5zM19 16h8v8h-8zM9 16v8h10M13 12h10v4" />
          </svg>
        )}
      </span>
      <span class="atlas-brand-full">{SITE.name}</span>
      <span class="atlas-brand-short">
        {SITE.kind === "umi" ? "Awesome UMI" : "Robot Data Engine"}
      </span>
    </a>
    <nav aria-label="Main navigation">
      <a href={sitePath() + "#catalog"}>Explore</a>
      {SITE.kind === "engine" && <a href={sitePath("sources/")}>Sources</a>}
      <a href={SITE.github + "#readme"} class="nav-readme">
        README ↗
      </a>
      <a href={SITE.github} class="atlas-github">
        <span class="star-label">Star on </span>GitHub{" "}
        <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>
